{
  "expo": {
    "name": "Waypoint",
    "slug": "waypoint-offline",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "waypoint",
    "updates": {
      "enabled": false
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waypoint.offline",
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Receive building maps directly from the building computer without internet.",
        "NSCameraUsageDescription": "Scan checkpoints to find your location."
      }
    },
    "android": {
      "package": "com.waypoint.offline",
      "permissions": [
        "CAMERA",
        "NEARBY_WIFI_DEVICES",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR checkpoints to confirm your position.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      "onnxruntime-react-native",
      "./plugins/with-onnx-package.cjs",
      "expo-build-properties",
      "./plugins/with-short-native-paths.cjs"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
