{
  "name": "waypoint-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-mobile.mjs",
    "test": "vitest run",
    "model": "node scripts/download-ai.mjs",
    "setup:chat": "node scripts/setup-chat.mjs",
    "chat:server": "node scripts/chat-server.mjs",
    "check:chat": "node --experimental-strip-types scripts/evaluate-chat.mjs",
    "package:building": "node scripts/package-building.mjs",
    "server": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "qr": "node scripts/print-qr.mjs",
    "setup": "npm run model && npm run package:building && npm run qr",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chat:sideload": "node scripts/sideload-chat.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lucide": "^0.468.0",
    "onnxruntime-web": "1.24.3",
    "qrcode": "^1.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.183.0",
    "esbuild": "0.25.12",
    "onnxruntime-node": "1.24.3",
    "prettier": "3.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "4.1.11"
  }
}
